{
	"name": "<REPO>",
	"version": "0.0.0",
	"private": true,
	"scripts": {
		"start": "npm run serve",
		"serve": "npx --no-install vite",
		"build": "npx --no-install vite build",
		"preview": "npx --no-install vite preview",
		"typecheck": "node scripts/workspace/typecheck.mts",
		"lint": "npx --no-install eslint . --ext .js,.cjs,.ts,.mts,.tsx,.cts --max-warnings 0",
		"lint-fix": "npx --no-install eslint . --ext .js,.cjs,.ts,.mts,.tsx,.cts --max-warnings 0 --fix",
		"format": "npx --no-install prettier . --write",
		"format-check": "npx --no-install prettier . --check",
		"test": "npx --no-install vitest run",
		"test-watch": "npx --no-install vitest",
		"mutation": "npx --no-install stryker run stryker.config.mts --incremental",
		"verify-gate": "npm audit --audit-level=critical && npm run lint && npm run format-check && npm run typecheck && npm test && npm run build"
	},
	"dependencies": {
		"@example/greeter": "*"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@stryker-mutator/core": "^10.0.0",
		"@stryker-mutator/vitest-runner": "^10.0.0",
		"@stylistic/eslint-plugin": "^5.10.0",
		"@types/node": "^24.0.0",
		"eslint": "^10.8.0",
		"eslint-import-resolver-typescript": "^4.4.5",
		"eslint-plugin-boundaries": "^7.2.0",
		"eslint-plugin-jsdoc": "^64.5.4",
		"globals": "^16.0.0",
		"jiti": "^2.7.0",
		"prettier": "^3.9.6",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.67.0",
		"vite": "^8.2.2",
		"vitest": "^4.1.11"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/<ORG>/<REPO>.git"
	},
	"bugs": {
		"url": "https://github.com/<ORG>/<REPO>/issues"
	},
	"homepage": "https://github.com/<ORG>/<REPO>#readme",
	"engines": {
		"node": ">=24.15.0"
	},
	"prettier": {
		"useTabs": true,
		"printWidth": 130
	},
	"workspaces": [
		"packages/*"
	],
	"overrides": {
		"handlebars@4.7.9": "4.7.10"
	}
}
